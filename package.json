{
  "name": "pi.lock",
  "version": "0.1.2",
  "type": "module",
  "description": "A portable Pi agent you can version and roll back with Git",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louis-she/pi.lock.git"
  },
  "bin": {
    "pi-lock": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "examples",
    "docs",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "node scripts/prepack.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "jiti": "2.7.0",
    "minimatch": "10.2.6",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
